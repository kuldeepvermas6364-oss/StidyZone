rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'did78994@gmail.com';
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && (
          (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.active == true &&
            get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role == 'super_admin') ||
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin')
        )
      );
    }

    function isContentAdmin() {
      return isVerifiedUser() && (
        (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.active == true &&
          get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role in ['content_admin', 'educator', 'moderator']) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['content_admin', 'educator', 'moderator'])
      );
    }

    function isAdmin() {
      return isSuperAdmin() || isContentAdmin();
    }

    function isValidExamTrack(track) {
      return track is string && track in ['up-board-12', 'jee-main', 'jee-advanced'];
    }

    function isValidStream(stream) {
      return stream is string && stream in ['science', 'commerce', 'arts'];
    }

    function isValidChapterStatus(status) {
      return status is string && status in ['not_started', 'in_progress', 'completed', 'needs_revision'];
    }

    function isValidPracticeStatus(status) {
      return status is string && status in ['not_started', 'in_progress', 'completed'];
    }

    function isValidLanguage(lang) {
      return lang is string && lang in ['en', 'hi'];
    }

    function isValidMedium(medium) {
      return medium is string && medium in ['hindi', 'english', 'bilingual'];
    }

    function isValidBilingualMap(m) {
      return m is map
        && m.keys().hasAll(['en', 'hi'])
        && m.keys().hasOnly(['en', 'hi'])
        && m.en is string && m.en.size() >= 1 && m.en.size() <= 2000
        && m.hi is string && m.hi.size() >= 1 && m.hi.size() <= 2000;
    }

    function isValidCountdownsMap(c) {
      return c is map
        && c.keys().hasOnly(['up-board-12', 'jee-main', 'jee-advanced'])
        && (!('up-board-12' in c) || (c['up-board-12'] is string && c['up-board-12'].size() == 10 && c['up-board-12'].matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && (!('jee-main' in c) || (c['jee-main'] is string && c['jee-main'].size() == 10 && c['jee-main'].matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && (!('jee-advanced' in c) || (c['jee-advanced'] is string && c['jee-advanced'].size() == 10 && c['jee-advanced'].matches('^\\d{4}-\\d{2}-\\d{2}$')));
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'provider', 'emailVerified', 'role', 'disabled', 'createdAt', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'provider', 'emailVerified', 'role', 'disabled', 'createdAt', 'lastLoginAt'])
        && isValidId(data.uid) && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.provider is string && data.provider in ['password', 'google.com']
        && data.emailVerified is bool
        && data.role is string && data.role in ['student', 'educator', 'moderator', 'super_admin']
        && data.disabled is bool
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidStudentProfile(data, userId) {
      return data.keys().hasAll(['uid', 'fullName', 'primaryExam', 'preferredLanguage', 'studyMedium', 'dailyStudyTargetMinutes', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'primaryExam', 'selectedStream', 'selectedSubjects', 'preferredLanguage', 'studyMedium', 'dailyStudyTargetMinutes', 'boardRollTargetYear', 'jeeTargetYear', 'schoolOrCoaching', 'district', 'countdowns', 'updatedAt'])
        && isValidId(data.uid) && data.uid == userId
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && isValidExamTrack(data.primaryExam)
        && (!('selectedStream' in data) || isValidStream(data.selectedStream))
        && (!('selectedSubjects' in data) || (data.selectedSubjects is list && data.selectedSubjects.size() <= 15 && (data.selectedSubjects.size() == 0 || data.selectedSubjects[0] is string)))
        && isValidLanguage(data.preferredLanguage)
        && isValidMedium(data.studyMedium)
        && data.dailyStudyTargetMinutes is number && data.dailyStudyTargetMinutes >= 30 && data.dailyStudyTargetMinutes <= 960
        && (!('boardRollTargetYear' in data) || (data.boardRollTargetYear is number && data.boardRollTargetYear >= 2025 && data.boardRollTargetYear <= 2035))
        && (!('jeeTargetYear' in data) || (data.jeeTargetYear is number && data.jeeTargetYear >= 2025 && data.jeeTargetYear <= 2035))
        && (!('schoolOrCoaching' in data) || (data.schoolOrCoaching is string && data.schoolOrCoaching.size() <= 150))
        && (!('district' in data) || (data.district is string && data.district.size() <= 100))
        && (!('countdowns' in data) || isValidCountdownsMap(data.countdowns))
        && data.updatedAt is timestamp;
    }

    function isValidBookmark(data, bookmarkId) {
      return data.keys().hasAll(['id', 'uid', 'itemType', 'itemId', 'examTrack', 'createdAt'])
        && data.keys().hasOnly(['id', 'uid', 'itemType', 'itemId', 'examTrack', 'note', 'createdAt'])
        && isValidId(data.id) && data.id == bookmarkId
        && isValidId(data.uid) && data.uid == request.auth.uid
        && data.itemType is string && data.itemType in ['chapter', 'topic', 'studyMaterial', 'question']
        && isValidId(data.itemId)
        && isValidExamTrack(data.examTrack)
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.createdAt is timestamp;
    }

    function isValidStudyProgress(data, progressId) {
      return data.keys().hasAll(['id', 'uid', 'examTrack', 'subjectId', 'chapterId', 'status', 'studyMinutesLogged', 'completionPercent', 'lastActivityAt'])
        && data.keys().hasOnly(['id', 'uid', 'examTrack', 'streamId', 'subjectId', 'chapterId', 'status', 'practiceStatus', 'completedTopicIds', 'studyMinutesLogged', 'completionPercent', 'lastActivityAt'])
        && isValidId(data.id) && data.id == progressId
        && isValidId(data.uid) && data.uid == request.auth.uid
        && isValidExamTrack(data.examTrack)
        && (!('streamId' in data) || data.streamId == null || isValidStream(data.streamId))
        && isValidId(data.subjectId)
        && isValidId(data.chapterId)
        && isValidChapterStatus(data.status)
        && (!('practiceStatus' in data) || isValidPracticeStatus(data.practiceStatus))
        && (!('completedTopicIds' in data) || (data.completedTopicIds is list && data.completedTopicIds.size() <= 200 && (data.completedTopicIds.size() == 0 || data.completedTopicIds[0] is string)))
        && data.studyMinutesLogged is number && data.studyMinutesLogged >= 0 && data.studyMinutesLogged <= 100000
        && data.completionPercent is number && data.completionPercent >= 0 && data.completionPercent <= 100
        && data.lastActivityAt is timestamp;
    }

    function isValidReadingHistory(data, entryId) {
      return data.keys().hasAll(['id', 'uid', 'materialId', 'examTrack', 'subjectId', 'materialType', 'lastViewedPage', 'lastAccessedAt'])
        && data.keys().hasOnly(['id', 'uid', 'materialId', 'examTrack', 'subjectId', 'chapterId', 'materialType', 'lastViewedPage', 'totalPages', 'lastAccessedAt'])
        && isValidId(data.id) && data.id == entryId
        && isValidId(data.uid) && data.uid == request.auth.uid
        && isValidId(data.materialId)
        && isValidExamTrack(data.examTrack)
        && isValidId(data.subjectId)
        && (!('chapterId' in data) || data.chapterId == null || isValidId(data.chapterId))
        && data.materialType is string && data.materialType.size() >= 2 && data.materialType.size() <= 40
        && data.lastViewedPage is number && data.lastViewedPage >= 1 && data.lastViewedPage <= 5000
        && (!('totalPages' in data) || data.totalPages == null || (data.totalPages is number && data.totalPages >= 1 && data.totalPages <= 5000))
        && data.lastAccessedAt is timestamp;
    }

    function isValidAdminCurriculum(data) {
      return data.keys().hasAll(['id', 'examTrack', 'isPublished'])
        && isValidId(data.id)
        && isValidExamTrack(data.examTrack)
        && data.isPublished is bool;
    }

    function isValidAdminRoleDoc(data, adminId) {
      return data.keys().hasAll(['uid', 'role', 'active', 'grantedByUid', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'role', 'permissions', 'active', 'grantedByUid', 'grantedAt'])
        && isValidId(data.uid) && data.uid == adminId
        && data.role is string && data.role in ['super_admin', 'content_admin', 'educator', 'moderator']
        && data.active is bool
        && isValidId(data.grantedByUid)
        && data.grantedAt is timestamp
        && (!('permissions' in data) || (data.permissions is list && data.permissions.size() <= 20));
    }

    function isValidAdminPermissionDoc(data, adminId) {
      return data.keys().hasAll(['uid', 'permissions', 'updatedByUid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'permissions', 'updatedByUid', 'updatedAt'])
        && isValidId(data.uid) && data.uid == adminId
        && data.permissions is list && data.permissions.size() <= 30
        && isValidId(data.updatedByUid)
        && data.updatedAt is timestamp;
    }

    function isValidAuditLogDoc(data, logId) {
      return data.keys().hasAll(['id', 'adminUid', 'adminEmail', 'adminRole', 'action', 'targetType', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'adminUid', 'adminEmail', 'adminRole', 'action', 'targetType', 'targetId', 'summary', 'status', 'createdAt'])
        && isValidId(data.id) && data.id == logId
        && isValidId(data.adminUid) && data.adminUid == request.auth.uid
        && data.adminEmail is string && data.adminEmail.size() >= 3 && data.adminEmail.size() <= 254
        && data.adminRole is string && data.adminRole.size() >= 2 && data.adminRole.size() <= 40
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && data.targetType is string && data.targetType.size() >= 2 && data.targetType.size() <= 60
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 500))
        && data.status is string && data.status in ['success', 'failure', 'denied']
        && data.createdAt == request.time;
    }

    // -------------------------------------------------------------------------
    // Connection Health Check Document
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // PII-Isolated Student Account & Profile Collections
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().role == 'student'
        && incoming().disabled == false
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserAccount(incoming(), userId)
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().email == existing().email
            && incoming().role == existing().role
            && incoming().disabled == existing().disabled
            && incoming().createdAt == existing().createdAt
            && incoming().lastLoginAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'emailVerified', 'lastLoginAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /profiles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidStudentProfile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidStudentProfile(incoming(), userId)
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName',
              'primaryExam',
              'selectedStream',
              'selectedSubjects',
              'preferredLanguage',
              'studyMedium',
              'dailyStudyTargetMinutes',
              'boardRollTargetYear',
              'jeeTargetYear',
              'schoolOrCoaching',
              'district',
              'countdowns',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // User-Scoped Bookmarks, Study Progress & Reading History
    // -------------------------------------------------------------------------
    match /bookmarks/{bookmarkId} {
      allow get: if isValidId(bookmarkId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(bookmarkId)
        && isVerifiedUser()
        && isValidBookmark(incoming(), bookmarkId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(bookmarkId)
        && isVerifiedUser()
        && isValidBookmark(incoming(), bookmarkId)
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['note'])
          )
        );
      allow delete: if isValidId(bookmarkId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    match /studyProgress/{progressId} {
      allow get: if isValidId(progressId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(progressId)
        && isVerifiedUser()
        && isValidStudyProgress(incoming(), progressId)
        && incoming().lastActivityAt == request.time;
      allow update: if isValidId(progressId)
        && isVerifiedUser()
        && isValidStudyProgress(incoming(), progressId)
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().examTrack == existing().examTrack
            && incoming().subjectId == existing().subjectId
            && incoming().chapterId == existing().chapterId
            && incoming().lastActivityAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['streamId', 'status', 'practiceStatus', 'completedTopicIds', 'studyMinutesLogged', 'completionPercent', 'lastActivityAt'])
          )
        );
      allow delete: if isValidId(progressId) && isAdmin();
    }

    match /readingHistory/{entryId} {
      allow get: if isValidId(entryId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(entryId)
        && isVerifiedUser()
        && isValidReadingHistory(incoming(), entryId)
        && incoming().lastAccessedAt == request.time;
      allow update: if isValidId(entryId)
        && isVerifiedUser()
        && isValidReadingHistory(incoming(), entryId)
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().materialId == existing().materialId
            && incoming().lastAccessedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastViewedPage', 'totalPages', 'lastAccessedAt'])
          )
        );
      allow delete: if isValidId(entryId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Hierarchical Admin-Managed Curriculum Tree (curriculums/examId/sessions/sessionId/...)
    // -------------------------------------------------------------------------
    match /curriculums/{examId}/sessions/{sessionId}/subjects/{subjectId} {
      allow get: if isValidId(examId) && isValidId(sessionId) && isValidId(subjectId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isValidId(examId) && isValidId(sessionId) && isValidId(subjectId) && isAdmin() && isValidAdminCurriculum(incoming()) && isValidBilingualMap(incoming().name);
      allow delete: if isValidId(examId) && isValidId(sessionId) && isValidId(subjectId) && isAdmin();

      match /chapters/{chapterId} {
        allow get: if isValidId(chapterId) && (existing().isPublished == true || isAdmin());
        allow list: if resource.data.isPublished == true || isAdmin();
        allow create, update: if isValidId(chapterId) && isAdmin() && isValidAdminCurriculum(incoming()) && isValidBilingualMap(incoming().title);
        allow delete: if isValidId(chapterId) && isAdmin();

        match /topics/{topicId} {
          allow get: if isValidId(topicId) && (existing().isPublished == true || isAdmin());
          allow list: if resource.data.isPublished == true || isAdmin();
          allow create, update: if isValidId(topicId) && isAdmin() && isValidId(incoming().id) && incoming().isPublished is bool && isValidBilingualMap(incoming().title);
          allow delete: if isValidId(topicId) && isAdmin();
        }
      }
    }

    // -------------------------------------------------------------------------
    // Published Curriculum & Assessment Collections (Admin-Written Only)
    // -------------------------------------------------------------------------
    match /subjects/{subjectId} {
      allow get: if isValidId(subjectId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isValidId(subjectId) && isAdmin() && isValidAdminCurriculum(incoming()) && isValidBilingualMap(incoming().name);
      allow delete: if isValidId(subjectId) && isAdmin();
    }

    match /chapters/{chapterId} {
      allow get: if isValidId(chapterId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isValidId(chapterId) && isAdmin() && isValidAdminCurriculum(incoming()) && isValidBilingualMap(incoming().title);
      allow delete: if isValidId(chapterId) && isAdmin();
    }

    match /topics/{topicId} {
      allow get: if isValidId(topicId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isValidId(topicId) && isAdmin() && isValidId(incoming().id) && incoming().isPublished is bool && isValidBilingualMap(incoming().title);
      allow delete: if isValidId(topicId) && isAdmin();
    }

    match /studyMaterials/{materialId} {
      allow get: if isValidId(materialId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isValidId(materialId) && isAdmin() && isValidAdminCurriculum(incoming()) && isValidBilingualMap(incoming().title);
      allow delete: if isValidId(materialId) && isAdmin();
    }

    match /questions/{questionId} {
      allow get: if isValidId(questionId) && ((isSignedIn() && existing().isPublished == true) || isAdmin());
      allow list: if (isSignedIn() && resource.data.isPublished == true) || isAdmin();
      allow create, update: if isValidId(questionId) && isAdmin() && isValidAdminCurriculum(incoming()) && isValidBilingualMap(incoming().prompt);
      allow delete: if isValidId(questionId) && isAdmin();
    }

    match /quizzes/{quizId} {
      allow get: if isValidId(quizId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isValidId(quizId) && isAdmin() && isValidAdminCurriculum(incoming()) && isValidBilingualMap(incoming().title);
      allow delete: if isValidId(quizId) && isAdmin();
    }

    match /mockTests/{mockTestId} {
      allow get: if isValidId(mockTestId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isValidId(mockTestId) && isAdmin() && isValidAdminCurriculum(incoming()) && isValidBilingualMap(incoming().title);
      allow delete: if isValidId(mockTestId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Prompt 4: Question Bank, Isolated Answer Keys, Exam Attempts & Analytics
    // -------------------------------------------------------------------------
    match /questionBank/{questionId} {
      allow get: if isValidId(questionId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isValidId(questionId)
        && isAdmin()
        && isValidAdminCurriculum(incoming())
        && isValidBilingualMap(incoming().prompt)
        && incoming().marks is number && incoming().marks >= 0
        && incoming().negativeMarks is number && incoming().negativeMarks >= 0;
      allow delete: if isValidId(questionId) && isAdmin();
    }

    match /questionAnswerKeys/{questionId} {
      allow get, list, create, update, delete: if isValidId(questionId) && isAdmin();
    }

    match /questionSets/{setId} {
      allow get: if isValidId(setId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isValidId(setId) && isAdmin() && isValidAdminCurriculum(incoming()) && isValidBilingualMap(incoming().title);
      allow delete: if isValidId(setId) && isAdmin();
    }

    match /examConfigurations/{configId} {
      allow get: if isValidId(configId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isValidId(configId) && isAdmin() && isValidAdminCurriculum(incoming()) && isValidBilingualMap(incoming().title);
      allow delete: if isValidId(configId) && isAdmin();
    }

    match /quizAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(attemptId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'configId', 'examTrack', 'status', 'startedAt'])
        && isValidId(incoming().id) && incoming().id == attemptId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && isValidId(incoming().configId)
        && isValidExamTrack(incoming().examTrack)
        && incoming().status == 'in_progress'
        && incoming().startedAt == request.time;
      allow update: if isValidId(attemptId)
        && isVerifiedUser()
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && existing().status == 'in_progress'
            && incoming().uid == existing().uid
            && incoming().configId == existing().configId
            && incoming().startedAt == existing().startedAt
            && incoming().status in ['in_progress', 'submitted']
            && incoming().diff(existing()).affectedKeys().hasOnly(['answers', 'visitedIds', 'markedForReviewIds', 'currentQuestionIndex', 'timeSpentSeconds', 'status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(attemptId) && isAdmin();
    }

    match /examAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(attemptId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'configId', 'examTrack', 'status', 'startedAt'])
        && isValidId(incoming().id) && incoming().id == attemptId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && isValidId(incoming().configId)
        && isValidExamTrack(incoming().examTrack)
        && incoming().status == 'in_progress'
        && incoming().startedAt == request.time;
      allow update: if isValidId(attemptId)
        && isVerifiedUser()
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && existing().status == 'in_progress'
            && incoming().uid == existing().uid
            && incoming().configId == existing().configId
            && incoming().startedAt == existing().startedAt
            && incoming().status in ['in_progress', 'submitted']
            && incoming().diff(existing()).affectedKeys().hasOnly(['answers', 'visitedIds', 'markedForReviewIds', 'currentQuestionIndex', 'timeSpentSeconds', 'status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(attemptId) && isAdmin();
    }

    match /studentAnswers/{answerId} {
      allow get: if isValidId(answerId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(answerId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'attemptId', 'questionId', 'updatedAt'])
        && isValidId(incoming().id) && incoming().id == answerId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && isValidId(incoming().attemptId)
        && isValidId(incoming().questionId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(answerId)
        && isVerifiedUser()
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().attemptId == existing().attemptId
            && incoming().questionId == existing().questionId
            && incoming().updatedAt == request.time
          )
        );
      allow delete: if isValidId(answerId) && isAdmin();
    }

    match /questionBookmarks/{bookmarkId} {
      allow get: if isValidId(bookmarkId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(bookmarkId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'questionId', 'examTrack', 'tag', 'createdAt'])
        && incoming().keys().hasOnly(['id', 'uid', 'questionId', 'examTrack', 'subjectId', 'chapterId', 'tag', 'note', 'createdAt'])
        && isValidId(incoming().id) && incoming().id == bookmarkId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && isValidId(incoming().questionId)
        && isValidExamTrack(incoming().examTrack)
        && incoming().tag in ['bookmark', 'difficult', 'revision']
        && (!('note' in incoming()) || (incoming().note is string && incoming().note.size() <= 400))
        && incoming().createdAt == request.time;
      allow update: if isValidId(bookmarkId)
        && isVerifiedUser()
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().questionId == existing().questionId
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['tag', 'note'])
          )
        );
      allow delete: if isValidId(bookmarkId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    match /practiceHistory/{entryId} {
      allow get: if isValidId(entryId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(entryId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'questionId', 'examTrack', 'isCorrect', 'attemptedAt'])
        && isValidId(incoming().id) && incoming().id == entryId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && isValidId(incoming().questionId)
        && isValidExamTrack(incoming().examTrack)
        && incoming().isCorrect is bool
        && incoming().attemptedAt == request.time;
      allow update: if isValidId(entryId)
        && isVerifiedUser()
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().questionId == existing().questionId
            && incoming().diff(existing()).affectedKeys().hasOnly(['markedForRevision', 'savedDifficult'])
          )
        );
      allow delete: if isValidId(entryId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    match /performanceAnalytics/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidId(incoming().uid) && incoming().uid == userId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /weakTopics/{topicEntryId} {
      allow get: if isValidId(topicEntryId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isValidId(topicEntryId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'topicId', 'accuracyPercent', 'updatedAt'])
        && isValidId(incoming().id) && incoming().id == topicEntryId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && isValidId(incoming().topicId)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(topicEntryId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Prompt 5: AI Study Assistant, PDF RAG, Quizzes, Recommendations & Plans
    // -------------------------------------------------------------------------
    match /aiConversations/{conversationId} {
      allow get: if isValidId(conversationId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(conversationId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'title', 'examTrack', 'languageMode', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['id', 'uid', 'title', 'examTrack', 'subjectId', 'chapterId', 'materialId', 'languageMode', 'createdAt', 'updatedAt'])
        && isValidId(incoming().id) && incoming().id == conversationId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 120
        && isValidExamTrack(incoming().examTrack)
        && incoming().languageMode in ['en', 'hi', 'hinglish']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(conversationId)
        && isVerifiedUser()
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 120
            && isValidExamTrack(incoming().examTrack)
            && incoming().languageMode in ['en', 'hi', 'hinglish']
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'examTrack', 'subjectId', 'chapterId', 'materialId', 'languageMode', 'updatedAt'])
          )
        );
      allow delete: if isValidId(conversationId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    match /aiMessages/{messageId} {
      allow get: if isValidId(messageId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(messageId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'conversationId', 'uid', 'role', 'content', 'createdAt'])
        && incoming().keys().hasOnly(['id', 'conversationId', 'uid', 'role', 'content', 'feedback', 'createdAt'])
        && isValidId(incoming().id) && incoming().id == messageId
        && isValidId(incoming().conversationId)
        && exists(/databases/$(database)/documents/aiConversations/$(incoming().conversationId))
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && incoming().role in ['user', 'assistant']
        && incoming().content is string && incoming().content.size() >= 1 && incoming().content.size() <= 20000
        && incoming().createdAt == request.time;
      allow update: if isValidId(messageId)
        && isVerifiedUser()
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().conversationId == existing().conversationId
            && incoming().createdAt == existing().createdAt
            && incoming().feedback in ['helpful', 'needs_review']
            && incoming().diff(existing()).affectedKeys().hasOnly(['feedback'])
          )
        );
      allow delete: if isValidId(messageId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    match /aiFeedback/{feedbackId} {
      allow get: if isValidId(feedbackId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(feedbackId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'messageId', 'rating', 'createdAt'])
        && incoming().keys().hasOnly(['id', 'uid', 'messageId', 'rating', 'note', 'createdAt'])
        && isValidId(incoming().id) && incoming().id == feedbackId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && isValidId(incoming().messageId)
        && incoming().rating in ['helpful', 'needs_review']
        && (!('note' in incoming()) || (incoming().note is string && incoming().note.size() <= 300))
        && incoming().createdAt == request.time;
      allow delete: if isValidId(feedbackId) && isAdmin();
    }

    match /aiUsage/{usageId} {
      allow get: if isValidId(usageId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if isValidId(usageId) && isAdmin();
    }

    match /documentChunks/{chunkId} {
      allow get: if isValidId(chunkId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.materialId is string;
      allow create, update, delete: if isValidId(chunkId) && isAdmin();
    }

    match /documentEmbeddings/{embeddingId} {
      allow get: if isValidId(embeddingId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.materialId is string;
      allow create, update, delete: if isValidId(embeddingId) && isAdmin();
    }

    match /generatedQuizzes/{quizId} {
      allow get: if isValidId(quizId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(quizId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'examTrack', 'subjectId', 'chapterId', 'sourceType', 'createdAt'])
        && isValidId(incoming().id) && incoming().id == quizId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && isValidExamTrack(incoming().examTrack)
        && isValidId(incoming().subjectId)
        && isValidId(incoming().chapterId)
        && incoming().sourceType == 'ai_generated'
        && incoming().createdAt == request.time;
      allow update: if isValidId(quizId)
        && isVerifiedUser()
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().sourceType == 'ai_generated'
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['savedToBank', 'title'])
          )
        );
      allow delete: if isValidId(quizId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    match /generatedSummaries/{summaryId} {
      allow get: if isValidId(summaryId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.chapterId is string;
      allow create, update, delete: if isValidId(summaryId) && isAdmin();
    }

    match /studyRecommendations/{recId} {
      allow get: if isValidId(recId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isValidId(recId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'examTrack', 'priority', 'updatedAt'])
        && isValidId(incoming().id) && incoming().id == recId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && isValidExamTrack(incoming().examTrack)
        && incoming().priority in ['high', 'medium', 'low']
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(recId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    match /aiStudyPlans/{planId} {
      allow get: if isValidId(planId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(planId)
        && isVerifiedUser()
        && incoming().keys().hasAll(['id', 'uid', 'examTrack', 'status', 'dailyHours', 'updatedAt'])
        && isValidId(incoming().id) && incoming().id == planId
        && isValidId(incoming().uid) && incoming().uid == request.auth.uid
        && isValidExamTrack(incoming().examTrack)
        && incoming().status in ['draft', 'approved']
        && incoming().dailyHours is number && incoming().dailyHours >= 0.5 && incoming().dailyHours <= 16
        && incoming().updatedAt == request.time;
      allow update: if isValidId(planId)
        && isVerifiedUser()
        && (
          isAdmin() || (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().examTrack == existing().examTrack
            && incoming().status in ['draft', 'approved']
            && incoming().dailyHours is number && incoming().dailyHours >= 0.5 && incoming().dailyHours <= 16
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedAt', 'weeklySchedule', 'dailyTargets', 'dailyHours', 'updatedAt'])
          )
        );
      allow delete: if isValidId(planId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Prompt 6: Super Admin, Content Admin, Permissions, Audit Logs & System Settings
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(adminId) && isSuperAdmin() && isValidAdminRoleDoc(incoming(), adminId);
      allow delete: if isValidId(adminId) && isSuperAdmin();
    }

    match /adminRoles/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(adminId) && isSuperAdmin() && isValidAdminRoleDoc(incoming(), adminId);
      allow delete: if isValidId(adminId) && isSuperAdmin();
    }

    match /adminPermissions/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(adminId) && isSuperAdmin() && isValidAdminPermissionDoc(incoming(), adminId);
      allow delete: if isValidId(adminId) && isSuperAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow get: if isValidId(logId) && (isSuperAdmin() || (isAdmin() && existing().adminUid == request.auth.uid));
      allow list: if isSuperAdmin() || (isAdmin() && resource.data.adminUid == request.auth.uid);
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLogDoc(incoming(), logId);
      allow update, delete: if false;
    }

    match /uploadJobs/{jobId} {
      allow get: if isValidId(jobId) && isAdmin();
      allow list: if isAdmin() && resource.data.adminUid is string;
      allow create, update: if isValidId(jobId)
        && isAdmin()
        && incoming().keys().hasAll(['id', 'adminUid', 'fileCount', 'successCount', 'failedCount', 'status', 'createdAt', 'updatedAt'])
        && isValidId(incoming().id) && incoming().id == jobId
        && isValidId(incoming().adminUid)
        && incoming().status in ['preview', 'completed', 'partial', 'failed'];
      allow delete: if isValidId(jobId) && isSuperAdmin();
    }

    match /aiSettings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list: if isAdmin() && resource.data.model is string;
      allow create, update: if isValidId(settingId)
        && isAdmin()
        && incoming().keys().hasAll(['id', 'enabled', 'model', 'dailyRequestLimit', 'dailyTokenLimit', 'rateLimitPerMin', 'updatedByUid', 'updatedAt'])
        && isValidId(incoming().id) && incoming().id == settingId
        && incoming().enabled is bool
        && incoming().model is string && incoming().model.size() >= 2 && incoming().model.size() <= 80
        && isValidId(incoming().updatedByUid)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isSuperAdmin();
    }

    match /systemSettings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(settingId)
        && isSuperAdmin()
        && incoming().keys().hasAll(['id', 'siteTitle', 'maintenanceMode', 'allowNewRegistrations', 'updatedByUid', 'updatedAt'])
        && isValidId(incoming().id) && incoming().id == settingId
        && incoming().siteTitle is string && incoming().siteTitle.size() >= 2 && incoming().siteTitle.size() <= 120
        && incoming().maintenanceMode is bool
        && incoming().allowNewRegistrations is bool
        && isValidId(incoming().updatedByUid)
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isSuperAdmin();
    }

    match /adminIntegrationStatus/{integrationId} {
      allow get: if isValidId(integrationId) && isAdmin();
      allow list: if isAdmin() && resource.data.integrationId is string;
      allow create, update: if isValidId(integrationId)
        && isAdmin()
        && incoming().keys().hasAll(['id', 'integrationId', 'status', 'verifiedAt', 'updatedByUid'])
        && isValidId(incoming().id) && incoming().id == integrationId
        && incoming().integrationId is string && incoming().integrationId.size() >= 2 && incoming().integrationId.size() <= 80
        && incoming().status in ['connected', 'setup_required', 'unavailable']
        && isValidId(incoming().updatedByUid)
        && incoming().verifiedAt == request.time;
      allow delete: if isValidId(integrationId) && isSuperAdmin();
    }
  }
}

