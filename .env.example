# GEMINI_API_KEY: Required for Gemini AI API calls (future AI Study Assistant module).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Future Firebase Client Configuration (Prompt 2+ / Production Integration)
# Do NOT commit real secrets. Populate these in your deployment environment.
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# -----------------------------------------------------------------------------
# Server-Side Study Material Storage & Signed URL Delivery (Prompt 3+)
# Keep signing secrets strictly server-side (never prefix with VITE_).
# -----------------------------------------------------------------------------
STORAGE_SIGNING_SECRET=""
FIREBASE_STORAGE_BUCKET=""

# -----------------------------------------------------------------------------
# Server-Side Gemini AI Study Assistant Configuration (Prompt 5)
# Keep GEMINI_API_KEY strictly server-side (never prefix with VITE_).
# -----------------------------------------------------------------------------
GEMINI_MODEL="gemini-4-hydrogen"
AI_DAILY_REQUEST_LIMIT="40"
AI_DAILY_TOKEN_LIMIT="120000"
AI_RATE_LIMIT_PER_MIN="12"
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_PDF_BYTES="10485760"
AI_MAX_PDF_PAGES="80"

# -----------------------------------------------------------------------------
# Server-Side Admin RBAC & Bootstrap Security (Prompt 6)
# Keep ADMIN_BOOTSTRAP_SECRET strictly server-side (never prefix with VITE_).
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAILS="did78994@gmail.com"
ADMIN_BOOTSTRAP_SECRET=""

