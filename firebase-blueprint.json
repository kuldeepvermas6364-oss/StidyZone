        "order": { "type": "number" }
      },
      "required": ["id", "chapterId", "subjectId", "title", "syllabusCode", "difficulty", "isPublished", "order"]
    },
    "StudyMaterial": {
      "title": "StudyMaterial",
      "description": "PDF notes, NCERT books, PYQs, model papers, official portals, and authorized video lecture metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "examTrack": { "type": "string", "enum": ["up-board-12", "jee-main", "jee-advanced"] },
        "academicSession": { "type": "string", "maxLength": 32 },
        "classLevel": { "type": "string", "enum": ["class-12", "entrance-ug"] },
        "streamId": { "type": "string", "enum": ["science", "commerce", "arts"] },
        "subjectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chapterId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topicId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "materialType": {
          "type": "string",
          "enum": [
            "ncert_book",
            "chapter_notes",
            "class_notes",
            "revision_notes",
            "important_questions",
            "pyq_paper",
            "sample_paper",
            "model_paper",
            "formula_sheet",
            "derivations",
            "practical_guide",
            "official_syllabus",
            "video_lecture"
          ]
        },
        "title": { "type": "object" },
        "description": { "type": "object" },
        "language": { "type": "string", "enum": ["en", "hi", "bilingual"] },
        "fileFormat": { "type": "string", "enum": ["PDF", "VIDEO", "WEB_PORTAL"] },
        "fileSizeBytes": { "type": "number" },
        "pageCount": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "storageProvider": { "type": "string", "enum": ["local-signed-storage", "firebase-storage", "external-official"] },
        "storagePath": { "type": "string", "maxLength": 500 },
        "externalSourceUrl": { "type": "string", "maxLength": 500 },
        "distributionType": { "type": "string", "enum": ["authorized_pdf", "protected_pdf", "official_external_link", "authorized_video"] },
        "accessLevel": { "type": "string", "enum": ["public", "authenticated"] },
        "downloadAllowed": { "type": "boolean" },
        "visibility": { "type": "string", "enum": ["public", "authenticated", "restricted"] },
        "publicationStatus": { "type": "string", "enum": ["published", "draft", "archived"] },
        "isOfficial": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["verified", "awaiting_verification"] },
        "isPublished": { "type": "boolean" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdByUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "examTrack", "subjectId", "materialType", "title", "language", "storageProvider", "distributionType", "accessLevel", "isPublished", "publishedAt", "createdByUid"]
    },
