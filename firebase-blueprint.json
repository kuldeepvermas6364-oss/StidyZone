{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Core student or admin account record (PII isolated to owner/admin).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "provider": { "type": "string", "enum": ["password", "google.com"] },
        "emailVerified": { "type": "boolean" },
        "role": { "type": "string", "enum": ["student", "educator", "moderator", "super_admin"] },
        "disabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "provider", "emailVerified", "role", "disabled", "createdAt", "lastLoginAt"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Student preparation preferences, selected UP Board stream/subjects, daily target, and exam countdown dates.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "primaryExam": { "type": "string", "enum": ["up-board-12", "jee-main", "jee-advanced"] },
        "selectedStream": { "type": "string", "enum": ["science", "commerce", "arts"] },
        "selectedSubjects": { "type": "array" },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi"] },
        "studyMedium": { "type": "string", "enum": ["hindi", "english", "bilingual"] },
        "dailyStudyTargetMinutes": { "type": "number" },
        "boardRollTargetYear": { "type": "number" },
        "jeeTargetYear": { "type": "number" },
        "schoolOrCoaching": { "type": "string", "maxLength": 150 },
        "district": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "primaryExam", "preferredLanguage", "studyMedium", "dailyStudyTargetMinutes", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Bilingual subject catalog per exam track and academic session.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
